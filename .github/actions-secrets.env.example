# GitHub Actions secrets for Kinus: fill in the values, then add them to GitHub (see the
# bottom). Never commit the filled-in copy: save it as .github/actions-secrets.env (ignored
# by git) or keep it outside the repository.
#
# Needed for the migration workflows ("DB → apply migrations"):
#
# SUPABASE_DB_URL: Supabase → your project → Connect (top bar) → "Session pooler"
#   connection string, with your database password put in place of [YOUR-PASSWORD].
#   Use the Session pooler one (port 5432, host like aws-0-us-east-1.pooler.supabase.com,
#   user postgres.<project-ref>): GitHub's machines can't reach the "Direct connection"
#   address. If the password has @ : / ? # or %, reset it to letters and numbers only
#   (Project Settings → Database → Reset database password), or percent-encode it.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Only for the "Setup — apply schema, create owner" workflow (inviting the first owner):
#
# SUPABASE_URL: Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: Supabase → Project Settings → API keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------------------
# Adding them to GitHub
#
# On the website: github.com/gsheetsacct-arch/Kinus → Settings → Secrets and variables →
#   Actions → New repository secret: one per line above (name, then value).
#
# Or with the GitHub command line, from the repository folder, all at once:
#   gh secret set -f .github/actions-secrets.env
#
# The migration workflow runs in the "production" environment: repository secrets work
# there too. (If you'd rather keep the database password only on that environment:
#   gh secret set -f .github/actions-secrets.env --env production)
